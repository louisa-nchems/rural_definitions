library(shiny)
library(bslib)
library(shinycssloaders)
ui <- page_sidebar(
title = div(tags$b("Rural Definitions and Public Institutions"),
img(src = "Logo for em.png", height = "35px", width = "auto",
style = "position: absolute;
top: 1px;
right: 2%;")),
# title = span(img(src = "Logo for em.png", height = 35), tags$p("Rural Definitions and Public Institutions", style = "font-size: 18px; font-weight: bold")),
sidebar = sidebar(radioButtons(inputId = "rural_def",
label = "Select Rural Definition:",
choices = c("Metro/Non-Metro", "RUCA Codes", "IPEDS Locales", "Rural-Serving"), #"RUCA Codes", "FAR Codes",
selected = "Metro/Non-Metro"),
radioButtons(inputId = "rural_filter",
label = "Filter for Rural:",
choices = c("All", "Rural", "Urban"),
selected = "All"),
selectInput(inputId = "state",
label = "Filter by State:",
choices = c("All", sort(unique(map_data_geo$`State Name`))),
selected = "All"),
checkboxGroupInput(inputId = "sector",
label = "Filter by Institution Sector:",
choices = unique(map_data_geo$NCHEMS_Sector_name),
selected = unique(map_data_geo$NCHEMS_Sector_name)),
sliderInput(inputId = "inst_size",
label = "Filter by Instititution Size\n(Annual Student FTE):",
step = 500,
value = c(slider_min, slider_max), min = slider_min, max = slider_max),
selectizeInput(inputId = "institution",
label = "Go to Institution:",
multiple = FALSE,
choices = "All",
selected = "All"),
div(
style = "text-align: right; margin-top: -20px; font-size: 0.9em; color: #0072B2;",
actionLink("reset_button", "Clear")
)
),
card(full_screen = TRUE,
maplibreOutput("map")|>
shinycssloaders::withSpinner(caption = "Data Loading...") |>
bslib::as_fill_carrier()), #|> shinycssloaders::withSpinner(caption = "Data Loading...")
card(card_body(div(tableOutput("summary_table"), style = "font-size:75%"), min_height = 100)),
# tags$p("Definitions and Sources:", style = "font-size: 12px; margin-bottom: -20px; font-weight: bold;"),
# div(uiOutput("desc"), style = "font-size:60%"),
accordion(accordion_panel("Definitions and Sources:",div(uiOutput("desc"), style = "font-size:60%")), open = FALSE),
# downloadButton(
#   outputId = "download_data",
#   label = "Download Data",
#   icon = shiny::icon("download")
# ),
tags$head(tags$style(HTML('.accordion-button{
font-size: 12px;
font-weight: bold;
}')))
)
server <- function(input, output, session) {
output$map <- renderMaplibre({
map |>
inst_layer_f() |>
metro_legend_f()
})
map_proxy <- maplibre_proxy("map")
observeEvent(input$rural_def, {
if(input$rural_def == "Metro/Non-Metro") map_proxy |> metro_legend_f()
else if(input$rural_def == "RUCA Codes") ruca_legend_f(map_proxy)
# else if(input$rural_def == "FAR Codes") far_legend_f(map_proxy)
else if(input$rural_def == "IPEDS Locales") locale_legend_f(map_proxy)
else if(input$rural_def == "Rural-Serving") map_proxy |> rural_serving_layer_f() |> rural_serving_legend_f()
map_proxy |>
set_layout_property("metro_layer", "visibility", if_else(input$rural_def == "Metro/Non-Metro", "visible","none")) |>
set_layout_property("ruca_layer", "visibility", if_else(input$rural_def == "RUCA Codes", "visible","none")) |>
# set_layout_property("far_layer", "visibility", if_else(input$rural_def == "FAR Codes", "visible","none")) |>
set_layout_property("locale_layer", "visibility", if_else(input$rural_def == "IPEDS Locales", "visible","none")) |>
set_layout_property("rural_serving_layer", "visibility", if_else(input$rural_def == "Rural-Serving", "visible","none")) |>
set_layout_property("institution_layer", "visibility", if_else(input$rural_def != "Rural-Serving", "visible","none"))
updateRadioButtons(session,
inputId = "rural_filter",
choices = c("All", case_when(input$rural_def == "Metro/Non-Metro" ~ rev(unique(na.omit(map_data_geo$Metro_simple))),
input$rural_def == "RUCA Codes" ~ rev(unique(na.omit(map_data_geo$RUCA_urban_rural))),
input$rural_def == "Rural-Serving" ~ rev(unique(na.omit(map_data_geo$RSI_simple))),
input$rural_def == "IPEDS Locales" ~ rev(unique(na.omit(map_data_geo$Locale_Urban_Rural))))))
})
observeEvent(list(input$state, input$institution), {
map_bounds <- state_boundaries |>
filter(case_when(input$state == "All" & input$institution == "All" ~ !NAME %in% c("Alaska", "Hawaii", "Puerto Rico"),
input$institution != "All" ~ NAME %in% insts()$`State Name`,
TRUE ~ NAME == input$state))
map_proxy |>
fit_bounds(map_bounds, animate = TRUE)})
df <- reactive({map_data_geo |>
st_drop_geometry() |>
mutate("Rural Category" = case_when(input$rural_def == "Metro/Non-Metro" ~ Metro_simple,
input$rural_def == "RUCA Codes" ~ RUCA_urban_rural,
# input$rural_def == "FAR Codes" ~ far_desc,
input$rural_def == "Rural-Serving" ~ RSI_detail,
input$rural_def == "IPEDS Locales" ~ Locale_Urban_Rural))})
insts <- reactive({df() |>
filter(
Annual_FTE >= min(input$inst_size),
Annual_FTE <= max(input$inst_size),
NCHEMS_Sector_name %in% input$sector,
case_when(input$rural_filter == "All" ~ `Rural Category` == `Rural Category`,
input$rural_def == "Rural-Serving" ~ RSI_simple == input$rural_filter,
TRUE ~ `Rural Category` == input$rural_filter),
case_when(input$institution != "All" ~ INSTNM == input$institution,
input$state != "All" ~ `State Name` == input$state,
TRUE ~ `State Name` == `State Name`))
# |>
#   pull(UNITID)
})
#This is the list of options for institutions that are available to search. They depend on the other filters, so you can't choose a rural institution if "urban" is selected, for example.
inst_options <- reactive({df() |>
filter(
Annual_FTE >= min(input$inst_size),
Annual_FTE <= max(input$inst_size),
NCHEMS_Sector_name %in% input$sector,
case_when(input$rural_filter == "All" ~ `Rural Category` == `Rural Category`,
input$rural_def == "Rural-Serving" ~ RSI_simple == input$rural_filter,
TRUE ~ `Rural Category` == input$rural_filter),
case_when(input$state != "All" ~ `State Name` == input$state, TRUE ~ `State Name` == `State Name`)
) |>
pull(INSTNM) |> unique()})
states <- reactive({df() |>
filter(case_when(input$institution != "All" ~ `State Name` %in% unique(insts()$`State Name`),
input$state != "All" ~ `State Name` == input$state,
TRUE ~ `State Name` == `State Name`)
) |>
pull(`State Name`)})
sectors <- reactive({df() |>
filter(
case_when(input$state != "All" ~ `State Name` == input$state, TRUE ~ `State Name` == `State Name`)
) |>
pull(NCHEMS_Sector_name) |> unique()})
min_max <- reactive({df() |>
filter(
NCHEMS_Sector_name %in% input$sector,
case_when(input$rural_filter == "All" ~ `Rural Category` == `Rural Category`,
input$rural_def == "Rural-Serving" ~ RSI_simple == input$rural_filter,
TRUE ~ `Rural Category` == input$rural_filter),
case_when(input$state != "All" ~ `State Name` == input$state, TRUE ~ `State Name` == `State Name`)
) |>
summarise(min = floor(min(Annual_FTE, na.rm = TRUE)/500)*500,
max = ceiling(max(Annual_FTE, na.rm = TRUE)/500)*500)})
summary_for_table <- reactive({df() |>
filter(UNITID %in% insts()$UNITID,
campus_type == "main campus") |>
#Calculate medians excluding institutions that have no state or local appropriations (military academies, tribal colleges)
mutate(appropriations_per_fte_no_zeros = na_if(`State and Local Appropriations per FTE`,0)) |>
group_by(`Rural Category`) |>
summarise("Number of Institutions" = n_distinct(UNITID),
across(c(appropriations_per_fte_no_zeros, Annual_FTE), ~ median(.x, na.rm = TRUE), .names = "Median {.col}"),
sort = mean(rsi_score, na.rm = TRUE)) |>
ungroup() |>
rename("Median Annual Student FTE" = "Median Annual_FTE") |>
mutate("Median Annual Student FTE" = scales::label_comma(accuracy = 1)(`Median Annual Student FTE`),
"Median State and Local Appropriations per FTE" = scales::label_dollar(accuracy = 1)(`Median appropriations_per_fte_no_zeros`)) |>
select(-`Median appropriations_per_fte_no_zeros`) |>
arrange(desc(sort)) |>
select(-sort)})
text <- reactive({HTML(str_c(case_when(input$rural_def == "Metro/Non-Metro" ~ ("<strong>Metro/Non-Metro</strong> Source: Office of Management and Budget, 2023. Boundaries are based on counties. Rural counties include both micropolitan statistical areas of 10,000-49,999 inhabitants and areas with smaller populations. Urban counties include metropolitan statistical areas of at least 50,000 inhabitants as well as any adjacent counties that have a high degree of social and economic integration with the urban core. <a href='https://www.census.gov/programs-surveys/metro-micro/about.html' target='_blank' rel='noopener noreferrer'>More information here.</a>"),
input$rural_def == "RUCA Codes" ~ "<strong>RUCA (Rural-Urban Commuting Area) Codes</strong>  Source: USDA Economic Research Service. Based on 2020 census tracts. Rural areas are places outside of an urban area of 50,000+ inhabitants AND have less than 30% commuting flow to an urbanized area of 50,000 or more. <a href='https://www.ers.usda.gov/data-products/rural-urban-commuting-area-codes' target='_blank' rel='noopener noreferrer'>More information here.</a>",
# input$rural_def == "FAR Codes" ~ "",
input$rural_def == "IPEDS Locales" ~ ("<strong>IPEDS Locales</strong> Source: NCES Education Demographic and Geographic Estimates (EDGE). Rural locales include areas classified as rural (fringe, distant and remote), plus distant and remote towns. Urban locales include cities (large, midsize, and small) plus fringe towns. Categories are based on U.S. Census urban/rural boundaries, distances, and population sizes. <a href='https://nces.ed.gov/programs/edge/Geographic/LocaleBoundaries'  target='_blank' rel='noopener noreferrer'>More information and detailed definitions here.</a>"),
input$rural_def == "Rural-Serving" ~ ("<strong>Rural-Serving Institution</strong> Source: Alliance for Research on Regional Colleges (ARRC). Rural-Serving includes institutions with a rural-serving index above the nationwide average. High Rural-Serving includes institutions with a rural-serving index at least one standard deviation above the nationwide average. Values are not available for graduate-only institutions, special focus institutions, or vocational and career technical colleges.<br>The index is based on five factors from the U.S. Census and IPEDS: 1. Percent of institution’s home county population classified as rural. 2. Average percent of adjacent counties’ population classified as rural. 3. Population size of institution’s home county. 4. Institution’s home county adjacency to a metro area. 5. Percent of institution’s total awards conferred in Agriculture, Natural Resources, and Parks & Recreation. <a href='https://www.regionalcolleges.org/project/ruralserving' target='_blank' rel='noopener noreferrer'>More information here.</a>")),
("<br><strong>FTE and Appropriations</strong> Source: NCES IPEDS Annual Enrollment Survey efia2023 and Finance Surveys f2223_f1a and f2223_f2, provisional release files. State and local appropriations include appropriations and nonoperating grants. Colorado also includes state operating grants and contracts. Institutions with zero state or local appropriations are excluded from the Median State and Local Appropriations per FTE calculation.")))
})
#Identify in memory the values from the inputs
selected_vars <- reactiveValues(sector = unique(map_data_geo$NCHEMS_Sector_name),
min_size = slider_min,
max_size = slider_max)
observeEvent(input$reset_button, {
updateSelectizeInput(session, "institution", selected = "All")
})
observe({
freezeReactiveValue(input, "institution")
updateSelectizeInput(session,
"institution",
choices = c("All", sort(inst_options())),
selected = "All",
server = TRUE)
})
observeEvent(list(input$state, input$sector, input$rural_filter), {
updateSliderInput(session,
inputId = "inst_size",
value = c(min_max()$min, min_max()$max),
min = min_max()$min,
max = min_max()$max)
})
observe({
selected_vars$sector <- input$sector
display_sectors <- if(is.null(selected_vars$sector)) character(0)
else str_subset(sectors(), glue::glue_collapse(selected_vars$sector, sep ="|"))
updateCheckboxGroupInput(session,
inputId = "sector",
choices = sectors(),
selected = display_sectors)
map_proxy |>
set_filter(
"institution_layer",
c("in", "UNITID", insts()$UNITID)
)
map_proxy |>
set_filter(
"rural_serving_layer",
c("in", "UNITID", insts()$UNITID)
)
map_proxy |>
set_filter(
"locale_layer",
c("in", "state_name", states())
)
map_proxy |>
set_filter(
"metro_layer",
c("in", "state_name", states())
)
map_proxy |>
set_filter(
"ruca_layer",
c("in", "state_name", states())
)
# map_proxy |>
#   set_filter(
#     "far_layer",
#     c("in", "state_name", states())
#   )
})
output$summary_table <- renderTable(summary_for_table(), striped= TRUE, spacing = "xs")
output$desc <- renderUI(text())
}
shinyApp(ui = ui, server = server)
# })
