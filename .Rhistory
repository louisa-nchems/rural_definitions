library(here)
library(tigris)
options(tigris_use_cache=TRUE)
library(readxl)
library(fs)
library(tidyverse)
library(rmapshaper)
library(geojsonsf)
library(geoarrow)
library(arrow, warn.conflicts = FALSE)
library(sf)
us_census_urban_areas <- urban_areas(year = 2024)
county_pct_rural_raw <- read_excel(here("data", "2020_UA_COUNTY.xlsx"), col_types = "text")
county_pct_rural_CT_raw <- read_excel(here("data", "2020_UA_COUNTY.xlsx"), sheet = "CT_2022", col_types = "text")
county_pct_rural_adjust <- county_pct_rural_raw |>
filter(STATE_NAME != "Connecticut") |>
bind_rows(county_pct_rural_CT_raw)
state_codes <- fips_codes |>
select(state, state_code, state_name) |>
distinct()
county_cbsa_crosswalk <- read_excel(here("data", "county_cbsa_crosswalk.xlsx"), col_types = "text", skip = 2) |>
select(`FIPS County Code`,`FIPS State Code`, `CBSA Title`, `Metropolitan/Micropolitan Statistical Area`, `State Name`) |>
distinct()
counties <- counties(cb = TRUE)
saveRDS(counties, here("stashed rds","counties.rds"))
counties <- readRDS(here("stashed rds","counties.rds"))
counties_with_metro_micro <- counties |>
left_join(county_cbsa_crosswalk, by = c("COUNTYFP" = "FIPS County Code", "STATEFP" = "FIPS State Code")) |>
mutate(Metro_detail = case_when(str_detect(`Metropolitan/Micropolitan Statistical Area`, "Metro") ~ "Urban / Metro Area",
str_detect(`Metropolitan/Micropolitan Statistical Area`, "Micro") ~ "Rural / Micro Area",
TRUE ~ "Rural / Neither Metro nor Micro"),
Metro_detail = fct_relevel(Metro_detail, "Rural / Neither Metro nor Micro"),
Metro_simple = str_extract(Metro_detail, "Rural|Urban")) |>
# select("County Name"= NAMELSAD, `CBSA Title`, "Metro") |>
mutate(county_or_metro = coalesce(`CBSA Title`, NAMELSAD)) |>
group_by(state_name = STATE_NAME, county_or_metro, Metro_detail, Metro_simple) |>
summarise() |>
ungroup()
write_rds(counties_with_metro_micro, here("rural funding shiny app","data","counties_with_metro_micro.rds"))
metro_micro_simple <- counties_with_metro_micro |>
group_by(state_name, Metro_simple) |>
summarise() |>
ungroup()
write_rds(metro_micro_simple, here("rural funding shiny app","data","metro_micro_simple.rds"))
counties_with_rural_pct <- counties |>
left_join(county_pct_rural_adjust, by = c("COUNTYFP" = "COUNTY", "STATEFP" = "STATE", "STATE_NAME")) |>
mutate(POPPCT_RUR = as.numeric(POPPCT_RUR),
over_50pct_rural = case_when(POPPCT_RUR >= .5 ~ "Rural", TRUE ~ "Urban")) |>
select(state_name = STATE_NAME, county_name = NAMELSAD, POPPCT_RUR, over_50pct_rural)
saveRDS(counties_with_rural_pct, here("rural funding shiny app","data","counties_with_rural_pct.rds"))
census_tracts <- readRDS(here("stashed rds","census_tracts_2020.rds"))
ruca_codes <- read_excel(here("data", "RUCA-codes-2020-tract.xlsx"), sheet = "RUCA2020 Tract Data", skip = 1)
ruca_desc <- read_excel(here("data","RUCA-codes-2020-tract.xlsx"), sheet = "RUCA code description")
ruca_adjust <- ruca_codes |>
left_join(ruca_desc, by = c("SecondaryRUCA" = "Code")) |>
mutate(ruca_desc = str_c(Urban_Rural, " (", `Primary RUCA Code Definition, 2020`, "; ", `Secondary RUCA Code Definition, 2020`, " )"),
ruca_desc = str_remove(ruca_desc, "\\d+\\s+\\=\\s+"),
ruca_desc = str_remove(ruca_desc, ";.+ no additional code "),
ruca_desc = fct_reorder(ruca_desc,  desc(SecondaryRUCA)),
ruca_desc = fct_reorder(ruca_desc, if_else(Urban_Rural == "Urban", 1, 0)),
Urban_Rural= fct_relevel(Urban_Rural, "Rural"))
ruca_geo <- census_tracts |>
full_join(ruca_adjust, by = c("GEOID" = "TractFIPS23")) |>
left_join(state_codes, by = c("StateFIPS20" = "state_code")) |>
select(state_name, "Census tract" = GEOID, ruca_desc, RUCA_urban_rural = `Urban_Rural`)
ruca_geo_simple <- ruca_geo |>
group_by(state_name, RUCA_urban_rural) |>
summarise()
saveRDS(ruca_geo_simple, here("rural funding shiny app","data","ruca_geo.rds"))
rural_serving <- read_csv(here("data", "61f4a2e5f6fc31fd52bc19ff_ARRC_RSI Full Data File_Jan2022.csv"), col_types = cols(.default = "c")) |>
mutate(rsi_score = as.numeric(rsi_score),
RSI_detail = case_when(rsi_score > mean(rsi_score)+sd(rsi_score) ~ "High Rural-Serving",
rsi_score > mean(rsi_score) ~ "Rural-Serving",
TRUE ~ "Non Rural-Serving"),
RSI_detail = fct_relevel(RSI_detail, "Non Rural-Serving", after = Inf),
RSI_simple = case_when(RSI_detail %in% c("High Rural-Serving", "Rural-Serving") ~ "Rural-Serving", TRUE ~ "Non Rural-Serving"))
ipeds_locales_raw <- read_sf(here("data", "EDGE_Locale25_US", "EDGE_Locale25_US.shp"))
ipeds_locales_definitions <- read_excel(here("data","Locale Definitions.xlsx"), col_types = "text")
ipeds_locales_geo <- ipeds_locales_raw |>
st_make_valid() |>
left_join(ipeds_locales_definitions, by = c("LOCALE" = "Locale Code")) |>
left_join(state_codes, by = c("STATEFP" = "state_code")) |>
mutate(locale_detail = fct_reorder(`Type - Subtype`, desc(as.numeric(LOCALE))),
locale_simple = Locale_Urban_Rural) |>
group_by(state_name, locale_simple) |>
summarise() |>
ungroup() |>
sf_geojson() |>
ms_simplify(keep = 0.05, weighting = 0.9, sys = TRUE) |>
geojson_sf()
ipeds_locales_geo <- ipeds_locales_raw |>
st_make_valid() |>
left_join(ipeds_locales_definitions, by = c("LOCALE" = "Locale Code")) |>
left_join(state_codes, by = c("STATEFP" = "state_code")) |>
mutate(locale_detail = fct_reorder(`Type - Subtype`, desc(as.numeric(LOCALE))),
locale_simple = Locale_Urban_Rural) |>
group_by(state_name, locale_simple) |>
summarise() |>
ungroup()
st_write(ipeds_locales_geo, here("geo_json", "ipeds_locales_geo.geojson"), driver = "GeoJSON")
View(ipeds_locales_geo)
st_write(ipeds_locales_geo, here("geo_json", "ipeds_locales_geo1.geojson"), driver = "GeoJSON")
